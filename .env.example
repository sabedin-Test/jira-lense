# token = shared Jira API token (jira.js); oauth = per-user Atlassian MCP sign-in (mcp.js)
AUTH_MODE=token
JIRA_BASE_URL=https://eydti.atlassian.net
# token mode only
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
# oauth mode: must match the origin users open in the browser
APP_URL=http://localhost:3000
ATLASSIAN_MCP_URL=https://mcp.atlassian.com/v2/mcp
# Optional: OpenAI-compatible endpoint for natural-language summaries
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
PORT=3000
